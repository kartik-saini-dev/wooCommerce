{
  "name": "electrical",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:admin\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:admin": "npm run dev --workspace=admin",
    "build": "npm run build --workspace=client && npm run build --workspace=admin",
    "start": "concurrently \"npm run start --workspace=client\" \"npm run start --workspace=admin\"",
    "lint": "npm run lint --workspaces"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.6.0",
    "@prisma/client": "^5.19.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-email/components": "^1.0.12",
    "@serwist/next": "^9.5.12",
    "@tanstack/react-table": "^8.21.3",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "geist": "^1.7.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-auth": "^4.24.15",
    "next-cloudinary": "^6.17.5",
    "next-themes": "^0.4.6",
    "prisma": "^5.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
    "resend": "^6.18.1",
    "serwist": "^9.5.12",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "concurrently": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
